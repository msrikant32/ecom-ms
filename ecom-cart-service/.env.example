# Server
PORT=3003
NODE_ENV=development

# Must match ecom-auth-service's JWT_ACCESS_SECRET - this service verifies
# access tokens locally.
JWT_ACCESS_SECRET=change_me_access_secret

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# MongoDB - own database for this service
MONGODB_URI=mongodb://127.0.0.1:27017/ecom_cart

# Downstream service - validates product exists/active and captures current price
CATALOG_SERVICE_URL=http://localhost:3002

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

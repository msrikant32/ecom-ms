# Server
PORT=3005
NODE_ENV=development

# Internal-only service - never routed through the gateway. Every request
# (publish, receive, ack) must carry this via X-Internal-Secret. Must match
# INTERNAL_SECRET in every service that publishes or polls (order-service,
# inventory-service, notification-service).
INTERNAL_SECRET=change_me_internal_secret

# One event fans out to every queue in its array - mirrors an SNS topic with
# multiple SQS subscriptions. Each queue is consumed independently.
EVENT_QUEUES={"order.paid":["order-paid-inventory","order-paid-notification"],"order.failed":["order-failed-notification"],"order.cancelled":["order-cancelled-inventory","order-cancelled-notification"]}

# Queue defaults
DEFAULT_VISIBILITY_TIMEOUT_SECONDS=30
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_MAX_MESSAGES=5

# Rate limiting - higher than a typical API since consumers poll every few
# seconds and share one source IP with every other local service.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

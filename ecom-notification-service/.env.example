# Server
PORT=3008
NODE_ENV=development

# Must match ecom-auth-service's JWT_ACCESS_SECRET (for the admin-facing REST endpoint)
JWT_ACCESS_SECRET=change_me_access_secret

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# MongoDB - own database for this service
MONGODB_URI=mongodb://127.0.0.1:27017/ecom_notification

# Event bus - this service polls the order-paid-notification and
# order-failed-notification queues rather than receiving webhooks. Must
# match event-bus's INTERNAL_SECRET.
EVENT_BUS_URL=http://localhost:3005
INTERNAL_SECRET=change_me_internal_secret
WORKER_POLL_INTERVAL_MS=3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

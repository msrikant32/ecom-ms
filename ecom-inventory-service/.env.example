# Server
PORT=3007
NODE_ENV=development

# Must match ecom-auth-service's JWT_ACCESS_SECRET (for the admin-facing REST endpoints)
JWT_ACCESS_SECRET=change_me_access_secret

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# MongoDB - own database for this service
MONGODB_URI=mongodb://127.0.0.1:27017/ecom_inventory

# Seeds a product's stock record on first sighting (this service doesn't own
# stock truth for unseen products until an order touches them).
CATALOG_SERVICE_URL=http://localhost:3002

# Event bus - this service polls the order-paid-inventory queue rather than
# receiving a webhook. Must match event-bus's INTERNAL_SECRET.
EVENT_BUS_URL=http://localhost:3005
INTERNAL_SECRET=change_me_internal_secret
WORKER_POLL_INTERVAL_MS=3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

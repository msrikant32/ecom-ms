# Server
PORT=3002
NODE_ENV=development

# Must match ecom-auth-service's JWT_ACCESS_SECRET - this service verifies
# access tokens locally (no network call back to auth-service per request).
JWT_ACCESS_SECRET=change_me_access_secret

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# MongoDB - own database for this service (DB-per-service)
MONGODB_URI=mongodb://127.0.0.1:27017/ecom_catalog

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

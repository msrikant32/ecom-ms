# docker-compose reads a file literally named `.env` in this directory
# automatically - `cp .env.docker.example .env` before `docker compose up`.
#
# Shared secrets, interpolated via ${VAR} into every service that needs them
# in docker-compose.yml instead of repeating the same value in 8 places.
# Same defaults as each service's own .env.example - change them for
# anything beyond local dev (Secrets Manager / NFR6 is still deferred, see
# ARCHITECTURE.md's "Not built yet").
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
INTERNAL_SECRET=change_me_internal_secret

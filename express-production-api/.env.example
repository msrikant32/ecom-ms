# Server
PORT=3000
NODE_ENV=development

# JWT secrets - generate strong random values in real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# CSRF - secret used to sign double-submit CSRF tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=change_me_csrf_secret

# WebSocket
WS_TICKET_TTL_SECONDS=15
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_MESSAGES_PER_WINDOW=20
WS_RATE_LIMIT_WINDOW_MS=10000

# TLS (optional) - set both to serve https/wss directly from this process.
# Leave unset if TLS is terminated upstream (load balancer/reverse proxy),
# which is the more common production setup.
TLS_KEY_PATH=
TLS_CERT_PATH=

# MongoDB - primary data store for users, products, and orders.
# Spin one up quickly with: docker compose up -d mongo
MONGODB_URI=mongodb://127.0.0.1:27017/express-production-api

# Cache / idempotency store
# The app connects here for response caching, idempotency locks, etc.
# If unset (or unreachable), it automatically falls back to an in-memory
# cache so it still runs locally without infra - but see the warning logged
# in production if this isn't configured (in-memory cache doesn't work
# correctly across more than one instance).
# Spin one up quickly with: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Chunked file upload
# UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_BYTES=2147483648
UPLOAD_MAX_CHUNK_SIZE_BYTES=20971520
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_CHUNK_RATE_LIMIT_MAX=2000
UPLOAD_MAX_SYNC_FILE_SIZE_BYTES=104857600
UPLOAD_PING_RATE_LIMIT_MAX=10000

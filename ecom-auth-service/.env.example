# Server
PORT=3001
NODE_ENV=development

# JWT secrets - generate strong random values in real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3100

# MongoDB - own database for this service (DB-per-service)
MONGODB_URI=mongodb://127.0.0.1:27017/ecom_auth

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
